+ifeq (${CCARCH},$(filter ${CCARCH},gcc gcc4 icc clang icx))
 	export CC := ${CCARCH}
 else
 	anerr := $(error Unknown C compiler arch: ${CCARCH})
@@ -82,7 +82,7 @@
     BASECFLAGS += -O3 -g3
     LDFLAGS += -static-intel
 else
-	ifeq (${CCARCH},$(filter ${CCARCH},gcc clang))
